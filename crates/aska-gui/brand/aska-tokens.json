{
  "name": "Aska",
  "version": "2.0.0",
  "graphite": {
    "0": "#FFFFFF",
    "50": "#F5F5F5",
    "100": "#EBEBEB",
    "200": "#DEDEDE",
    "300": "#BDBDBD",
    "400": "#9A9A9A",
    "500": "#666666",
    "600": "#4A4A4A",
    "700": "#2A2A2A",
    "800": "#1E1E1E",
    "900": "#161616",
    "950": "#0B0B0B"
  },
  "brand": {
    "ink": "#111111",
    "paper": "#FFFFFF"
  },
  "roles": {
    "background": {
      "light": "#FFFFFF",
      "dark": "#0B0B0B",
      "use": "Window background"
    },
    "surface": {
      "light": "#F5F5F5",
      "dark": "#161616",
      "use": "Editor, cards, header bar"
    },
    "surface-alt": {
      "light": "#EBEBEB",
      "dark": "#1E1E1E",
      "use": "Secondary buttons, table headers"
    },
    "border": {
      "light": "#DEDEDE",
      "dark": "#2A2A2A",
      "use": "Dividers, field outlines"
    },
    "border-strong": {
      "light": "#808080",
      "dark": "#666666",
      "use": "Outline of fields and the secondary button (3:1)"
    },
    "text": {
      "light": "#111111",
      "dark": "#F2F2F2",
      "use": "Note text, labels"
    },
    "text-muted": {
      "light": "#666666",
      "dark": "#9A9A9A",
      "use": "Footer, byte counter, hints"
    },
    "accent": {
      "light": "#111111",
      "dark": "#F2F2F2",
      "use": "Main button, focus ring, links"
    },
    "on-accent": {
      "light": "#FFFFFF",
      "dark": "#0B0B0B",
      "use": "Label on the main button"
    },
    "info": {
      "light": "#3D6A8F",
      "dark": "#8DB4D6",
      "use": "Blue banner"
    },
    "info-bg": {
      "light": "#EEF3F8",
      "dark": "#111A22",
      "use": "Blue banner background"
    },
    "success": {
      "light": "#2E7D4F",
      "dark": "#6FCF97",
      "use": "Tor connected, posted"
    },
    "warning": {
      "light": "#6E5600",
      "dark": "#E8C547",
      "use": "Amber banner"
    },
    "warning-bg": {
      "light": "#FAF6E6",
      "dark": "#1D1A0E",
      "use": "Amber banner background"
    },
    "danger": {
      "light": "#B3261E",
      "dark": "#FF8A80",
      "use": "Red banner, Close and burn"
    },
    "danger-bg": {
      "light": "#FCEFEE",
      "dark": "#2A1312",
      "use": "Red banner background"
    },
    "on-danger": {
      "light": "#FFFFFF",
      "dark": "#0B0B0B",
      "use": "Label on a danger fill"
    }
  },
  "typography": {
    "wordmark": {
      "family": "Jost",
      "weight": 500,
      "case": "uppercase",
      "tracking_em": 0.22,
      "note": "Logo only; outlined in the SVGs."
    },
    "display": {
      "family": "Jost",
      "weight": 500,
      "case": "uppercase",
      "tracking_em": 0.12,
      "use": "Headings on the website, documents, release notes."
    },
    "ui": "System font: Adwaita Sans/Cantarell (GNOME), Segoe UI (Windows), Roboto (Android), SF Pro (iOS).",
    "mono": {
      "family": "JetBrains Mono",
      "use": "Fingerprints, keys, relay addresses, build hashes."
    }
  },
  "spacing_px": [
    4,
    8,
    12,
    16,
    24,
    32,
    48,
    64
  ],
  "radius_px": {
    "control": 4,
    "card": 8,
    "app_tile_of_512": 112
  }
}
