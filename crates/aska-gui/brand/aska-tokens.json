{
  "name": "ASKA",
  "version": "3.0.0",
  "graphite": {
    "0": "#FFFFFF",
    "50": "#F5F5F5",
    "100": "#EBEBEB",
    "200": "#DEDEDE",
    "300": "#BDBDBD",
    "400": "#9A9A9A",
    "500": "#666666",
    "600": "#4A4A4A",
    "700": "#2A2A2A",
    "800": "#1E1E1E",
    "900": "#161616",
    "950": "#0B0B0B"
  },
  "brand": {
    "ink": "#111111",
    "paper": "#FFFFFF",
    "signal": "#F2C230"
  },
  "roles": {
    "background": {
      "light": "#FFFFFF",
      "dark": "#0B0B0B",
      "use": "Window background"
    },
    "surface": {
      "light": "#F5F5F5",
      "dark": "#161616",
      "use": "Editor, cards, header bar"
    },
    "surface-alt": {
      "light": "#EBEBEB",
      "dark": "#1E1E1E",
      "use": "Secondary buttons, keypad keys, table headers"
    },
    "border": {
      "light": "#DEDEDE",
      "dark": "#2A2A2A",
      "use": "Dividers and hairlines"
    },
    "border-strong": {
      "light": "#808080",
      "dark": "#666666",
      "use": "Outline of fields and the secondary button (3:1)"
    },
    "text": {
      "light": "#111111",
      "dark": "#F2F2F2",
      "use": "Body text, labels, headings"
    },
    "text-muted": {
      "light": "#666666",
      "dark": "#9A9A9A",
      "use": "Footer, counters, hints"
    },
    "accent": {
      "light": "#111111",
      "dark": "#F2C230",
      "use": "Main button fill"
    },
    "on-accent": {
      "light": "#F2C230",
      "dark": "#111111",
      "use": "Main button label"
    },
    "focus-ring": {
      "light": "#111111",
      "dark": "#F2C230",
      "use": "Focus ring, 2 px"
    },
    "signal": {
      "light": "#F2C230",
      "dark": "#F2C230",
      "use": "Signal yellow: the mark, the app tile, highlights. Never as text on light grounds"
    },
    "on-signal": {
      "light": "#111111",
      "dark": "#111111",
      "use": "Text and mark on signal yellow"
    },
    "info": {
      "light": "#3D6A8F",
      "dark": "#8DB4D6",
      "use": "Blue banner"
    },
    "info-bg": {
      "light": "#EEF3F8",
      "dark": "#111A22",
      "use": "Blue banner background"
    },
    "success": {
      "light": "#2E7D4F",
      "dark": "#6FCF97",
      "use": "Tor connected, posted"
    },
    "warning": {
      "light": "#8A4B00",
      "dark": "#FFB15C",
      "use": "Orange warning banner"
    },
    "warning-bg": {
      "light": "#FDF1E4",
      "dark": "#24180C",
      "use": "Warning banner background"
    },
    "danger": {
      "light": "#B3261E",
      "dark": "#FF8A80",
      "use": "Red banner, Close and burn"
    },
    "danger-bg": {
      "light": "#FCEFEE",
      "dark": "#2A1312",
      "use": "Red banner background"
    },
    "on-danger": {
      "light": "#FFFFFF",
      "dark": "#0B0B0B",
      "use": "Label on a danger fill"
    }
  },
  "typography": {
    "wordmark": {
      "family": "Archivo",
      "width": 125,
      "weight": 600,
      "case": "uppercase",
      "tracking_em": 0.14,
      "note": "Logo only; outlined in the SVGs."
    },
    "display": {
      "family": "Archivo",
      "width": 125,
      "weight": 600,
      "case": "uppercase",
      "tracking_em": 0.08
    },
    "ui": "System font: Adwaita Sans/Cantarell, Segoe UI, Roboto, SF Pro.",
    "mono": {
      "family": "JetBrains Mono",
      "use": "Fingerprints, keys, relay addresses, build hashes."
    }
  },
  "spacing_px": [
    4,
    8,
    12,
    16,
    24,
    32,
    48,
    64
  ],
  "radius_px": {
    "control": 2,
    "card": 4,
    "app_tile_of_512": 112
  }
}
